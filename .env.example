# Copy to `.env` at the repo root (both runners load `.env` from the working
# directory). Never commit the real `.env` — it is git-ignored; never log keys.

# ── Local LLM server ──────────────────────────────────────────
# OpenAI-compatible endpoint. Override the config default if needed.
LOCAL_LLM_ENDPOINT=http://127.0.0.1:1234/v1/chat/completions
# Any OpenAI-compatible server works (LM Studio, Unsloth desktop, llama-server,
# Ollama, vLLM) — e.g. Unsloth desktop: LOCAL_LLM_ENDPOINT=http://localhost:8889/v1
# (LM_STUDIO_ENDPOINT is the deprecated former name — still read, with a warning.)
# Bearer key for servers that require one (Unsloth desktop, llama-server --api-key).
# A secret: leave unset for LM Studio.
# LLM_API_KEY=
# Opt in to strict JSON response_format (some local setups reject it).
# (LM_STUDIO_USE_JSON_SCHEMA is the deprecated former name — still read, with a warning.)
# LOCAL_LLM_USE_JSON_SCHEMA=1

# ── Crypto exchange keys (OKX Europe by default, §7.64) ─────
# Leave BLANK to run in paper mode (live public data + PaperExecutor).
# With crypto_agent.testnet: true (default) these must be OKX **demo trading**
# keys (OKX → Trade → Demo Trading → Demo Trading API). A keyed LIVE run needs
# crypto_agent.testnet: false AND crypto_agent.live_trading: true AND
# LIVE_TRADING_ACK below — anything less stays on paper and logs why (§7.41).
# OKX requires all three values (the passphrase is set when creating the key).
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSPHRASE=

# Real-money acknowledgement (§7.41) — required for a keyed live exchange run and
# for xtb_execution.account_type: real. Must be exactly this phrase.
# LIVE_TRADING_ACK=I_ACCEPT_REAL_MONEY_RISK

# ── Saxo OpenAPI stocks execution (§7.66) — opt-in ─────────
# Leave unset to stay on the paper executor. To trade Saxo's free SIM account:
# enable `saxo_execution.enabled` in config/settings.yaml AND set the token (for
# SIM: the 24 h developer token from https://www.developer.saxo). Never commit it.
# SAXO_ACCESS_TOKEN=
# Saxo OAuth app (§7.66 step 4, saxo_execution.oauth.enabled) — then run
# `python -m scripts.saxo_login` once; the runner refreshes the tokens itself.
# SAXO_APP_KEY=
# SAXO_APP_SECRET=

# ── XTB (demo) execution via xAPI (§7.16) — DEAD PATH (§7.66), keep unset ──
# Leave unset to stay on the paper executor. To execute against an XTB *demo*
# account: enable `xtb_execution.enabled` in config/settings.yaml AND set both:
#   XTB_ACCOUNT_ID      — your demo account number
#   XTB_ACCOUNT_PASSWORD— the xAPI verification code generated in xStation
#                         (Settings → xAPI), NOT your login password.
# XTB_ACCOUNT_ID=
# XTB_ACCOUNT_PASSWORD=

# ── Alert channel (§7.51) — optional ────────────────────────
# Set to deliver alerts (LLM outages, execution errors, risk rejections, fills)
# beyond the log: any Slack/Discord/generic JSON webhook, or an ntfy topic URL
# (then set monitoring.alert_webhook_format: ntfy). The URL is a secret.
# ALERT_WEBHOOK_URL=
