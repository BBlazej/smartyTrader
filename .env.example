# Copy to `.env` at the repo root (both runners load `.env` from the working
# directory). Never commit the real `.env` — it is git-ignored; never log keys.

# ── LM Studio (local LLM) ─────────────────────────────────────
# OpenAI-compatible endpoint. Override the config default if needed.
LM_STUDIO_ENDPOINT=http://127.0.0.1:1234/v1/chat/completions
# Opt in to strict JSON response_format (some local setups reject it).
# LM_STUDIO_USE_JSON_SCHEMA=1

# ── Kraken (testnet) ────────────────────────────────────────
# Leave both BLANK to run in paper mode (live public data + PaperExecutor).
# Set these to run the crypto agent against the Kraken testnet.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# ── XTB (demo) — reserved ───────────────────────────────────
# Stocks execution stays simulated until the xAPI OAuth2 flow lands (PLAN §7.16).
# XTB_API_KEY=
